APP_NAME=CodeAtlas
APP_ENV=development
# Required outside development/test; protects search and repository routes.
# API_KEY=choose-a-private-key

POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas_dev
POSTGRES_DB=codeatlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas_dev@localhost:5432/codeatlas

ELASTICSEARCH_URL=http://localhost:9200
# Optional authenticated HTTPS endpoint, e.g. Elastic Cloud Hosted.
# ELASTICSEARCH_API_KEY=use-a-private-scoped-key
# Optional local transport workaround; default preserves search connection reuse.
# ELASTICSEARCH_CLOSE_SEARCH_CONNECTIONS=true

REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=300
# TTL must be a positive integer; zero/negative values fail startup.
GITHUB_WEBHOOK_SECRET=codeatlas-local-webhook-secret
HYBRID_SEMANTIC_WEIGHT=0.60
# Semantic weight must be finite and between 0 and 1 inclusive.
# Optional embedding execution settings; unset preserves automatic defaults.
# EMBEDDING_DEVICE=cpu
# TORCH_NUM_THREADS=1
# Per Git command timeout in seconds; default 120, positive integer.
# GIT_TIMEOUT_SECONDS=120
# HTTP body limit in bytes; default 1 MiB, positive integer.
# REQUEST_BODY_MAX_BYTES=1048576
# Total HTTP body receipt deadline in seconds; default 30, finite positive number.
# REQUEST_BODY_TIMEOUT_SECONDS=30
